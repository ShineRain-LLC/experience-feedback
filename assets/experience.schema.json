    "schemaVersion": {
      "const": 1
    },
    "invocationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,159}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "skillName": {
      "const": "experience-feedback"
    },
    "skillVersion": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 100
    },
    "activityType": {
      "type": "string",
      "enum": [
        "capture",
        "evaluate",
        "aggregate",
        "retrieve",
        "design"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "context": {
      "type": [
        "object",
        "null"
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 100
    },
    "result": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "partial",
            "failed",
            "blocked",
            "pending"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "basis": {
          "type": "string",
          "enum": [
            "system_observation",
            "user_report",
            "unavailable"
          ]
        }
      },
      "required": [
        "status",
        "summary",
        "basis"
      ],
      "additionalProperties": false
    },
    "adoption": {
      "type": "string",
      "enum": [
        "not_used",
        "partial",
        "full",
        "unknown"
      ]
    },
    "feedback": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "helpfulness": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "helpful",
            "partly_helpful",
            "not_helpful",
            "harmful",
            "uncertain",
            null
          ]
        },
        "reasons": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "enum": [
              "solved_problem",
              "saved_time",
              "reduced_cost",
              "avoided_mistakes",
              "easier_decision",
              "other"
            ]
          },
          "maxItems": 100
